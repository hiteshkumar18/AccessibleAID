{
  "name": "lumyn",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Lumyn — Privacy-first accessibility and emergency intelligence. Fully on-device AI.",
  "scripts": {
    "dev": "vite",
    "server": "cd backend && .venv/bin/python main.py",
    "server:node": "node server/index.mjs",
    "start": "concurrently -n \"pyserver,vite\" -c \"cyan,green\" \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview --host",
    "download-models": "cd backend && .venv/bin/python download_models.py"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "lucide-react": "^0.487.0",
    "motion": "^12.23.24",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "vite": "^8.0.11"
  }
}
